  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.5.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tailwindcss": "4.1.13",
    "@tailwindcss/postcss": "4.1.13",
